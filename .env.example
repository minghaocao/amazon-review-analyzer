# 复制本文件为 .env。默认使用本地 Ollama，不需要 API key。
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:8b
OLLAMA_HOST=http://localhost:11434
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=4096
OLLAMA_BENCHMARK_MODELS=qwen3:8b,qwen3:4b-instruct
BATCH_CHECKPOINT_INTERVAL=10
# Streamlit long jobs persist after each completed review (roughly one write
# per model response, not per UI update).
PRODUCTION_CHECKPOINT_INTERVAL=1
MAX_CONSECUTIVE_LLM_FAILURES=3
MIN_ASPECT_REVIEWS_FOR_RANKING=3
KEYWORD_MIN_REVIEW_COUNT=2
AMAZON_BROWSER_REVIEW_LIMIT=10
MAX_BROWSER_REVIEW_PAGES=3
AMAZON_BROWSER_NAVIGATION_TIMEOUT_MS=25000

# Optional OpenAI fallback
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MAX_OUTPUT_TOKENS=1200
